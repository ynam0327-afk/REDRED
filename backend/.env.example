# 이 파일은 .env.example 입니다. 실제 값을 넣은 .env 파일은 절대 커밋하지 마세요.
# 사용법: cp .env.example .env  후 아래 값을 채워넣으세요.

# --- 소방안전 빅데이터 플랫폼 ---
BIGDATA119_API_KEY=your_x_api_key_here

# --- 행정안전부 긴급재난문자 (safetydata.go.kr) ---
SAFETYDATA_API_KEY=your_service_key_here

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://redred:redred_dev_password@postgres:5432/redred

# --- Redis (메시지 큐 + 캐시) ---
REDIS_URL=redis://redis:6379/0
REDIS_STREAM_KEY=fire_events_stream

# --- 수집 주기 (초 단위, 우선 1시간=3600으로 시작, 실제 배치 갱신 주기 확인 후 조정) ---
POLL_INTERVAL_SECONDS=3600

# --- FCM (실시간 푸시) ---
# 이 인스턴스가 실제 발송을 담당하게 하려면 true로. 여러 곳에서 notification-service를
# 띄우게 되면(팀원 로컬 등) 중복 발송을 막기 위해 반드시 한 곳에서만 true로 둘 것.
ENABLE_PUSH_SCHEDULER=false
FCM_SERVICE_ACCOUNT_JSON_PATH=/secrets/fcm-service-account.json

# --- 스미싱 스코어 가중합 (선택, 생략 시 config.py 기본값 사용 - 팀원 모델 성능 나오는 대로 조정 예정) ---
# SMISHING_WEIGHT_URL=0.5
# SMISHING_WEIGHT_TEXT=0.5
# SMISHING_THRESHOLD_SUSPICIOUS=0.3
# SMISHING_THRESHOLD_DANGER=0.6